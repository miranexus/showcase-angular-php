<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /angular/showcase-angular-php/

  # If the requested file or directory exists, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Skip rewrite for php-api requests
  RewriteRule ^php-api/ - [L]

  # Prevent infinite loop for index.html
  RewriteRule ^index\.html$ - [L]

  # Otherwise, rewrite to index.html for Angular client-side routing
  RewriteRule . /angular/showcase-angular-php/index.html [L]
</IfModule>
# Ensure 404s serve index.html for Angular routes
ErrorDocument 404 /angular/showcase-angular-php/index.html
